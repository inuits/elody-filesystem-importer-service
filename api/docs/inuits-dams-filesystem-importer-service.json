{
  "openapi": "3.0.3",
  "info": {
    "title": "Inuits DAMS filesystem importer service API",
    "description": "An API to import files on the basis of a csv",
    "contact": {
      "email": "developers@inuits.eu"
    },
    "version": "0.0.1"
  },
  "externalDocs": {
    "description": "Find out more about DAMS",
    "url": "https://docs.inuits.io/dams/filesystem-importer-service"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/import": {
      "post": {
        "tags": ["import"],
        "summary": "Import a csv file",
        "operationId": "import",
        "requestBody": {
          "description": "Details needed to run an import",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/import-body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/import-response-200"
                }
              }
            }
          },
          "400": {
            "description": "malformed request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/import-response-400"
                }
              }
            }
          },
          "405": {
            "description": "invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/import-response-500"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Get health of file-system-importer service",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "successful operation"
          },
          "500": {
            "description": "internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "import-body": {
        "type": "object",
        "description": "Necessary import information",
        "required": ["selected-folder", "selected-file"],
        "properties": {
          "selected-folder": {
            "type": "string",
            "description": "Path to the selected folder"
          },
          "selected-file": {
            "type": "string",
            "description": "Name of the csv"
          },
          "ocr": {
            "type": "boolean",
            "description": "Should OCR files be imported implicitly"
          }
        }
      },
      "import-response-200": {
        "type": "object",
        "description": "Successfully started operation",
        "properties": {
          "status": {
            "type": "number",
            "description": "status_code",
            "example": 200
          },
          "message_id": {
            "type": "string",
            "description": "message id code",
            "example": "import-success"
          },
          "job_id": {
            "type": "string",
            "description": "Identifier of overarching job entity",
            "example": "4b8fe928-7136-40a7-87d7-1e1c15dc1d98"
          },
          "count": {
            "type": "number",
            "descritpion": "amount of csv's imported",
            "example": 1
          }
        }
      },
      "import-response-400": {
        "type": "object",
        "description": "Bad Request - CSV file not found",
        "properties": {
          "message": {
            "type": "string",
            "description": "Details about the error",
            "example": "data.csv not found"
          }
        }
      },
      "import-response-500": {
        "type": "object",
        "description": "Import error",
        "properties": {
          "status": {
            "type": "number",
            "description": "status_code",
            "example": 500
          },
          "message_id": {
            "type": "string",
            "description": "message id code",
            "example": "import-failure"
          },
          "job_id": {
            "type": "string",
            "description": "Identifier of overarching job entity",
            "example": "4b8fe928-7136-40a7-87d7-1e1c15dc1d98"
          }
        }
      }
    }
  }
}
